# syntax=docker/dockerfile:1.7
FROM ghcr.io/gohugoio/hugo:v0.146.2 AS hugo

FROM alpine/git:2.49.1 AS ryder
RUN git clone https://github.com/arts-link/ryder.git /ryder && \
    cd /ryder && git checkout --detach 309cd9c6bbd37950c94acdd3f07438e2036d76fb && \
    rm -rf /ryder/.git /ryder/node_modules /ryder/exampleSite/node_modules

FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core/package.json packages/core/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @sad/contracts build && pnpm --filter @sad/core build && pnpm --filter @sad/web build && pnpm --filter @sad/api build && pnpm deploy --legacy --filter @sad/api --prod /out

FROM node:24-bookworm-slim
ARG SAD_VERSION=0.1.0
ARG SAD_COMMIT=unknown
LABEL org.opencontainers.image.title="Screenshot-a-Day API" \
      org.opencontainers.image.version=$SAD_VERSION \
      org.opencontainers.image.revision=$SAD_COMMIT \
      org.opencontainers.image.source="https://github.com/arts-link/screenshot-a-day" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
ENV NODE_ENV=production SAD_PORT=4400 SAD_DATA_DIR=/data SAD_BUILD_COMMIT=$SAD_COMMIT
WORKDIR /app
COPY --from=build /out ./
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/web/dist /web/dist
COPY --from=build /app/apps/api/static-gallery ./static-gallery
COPY --from=hugo /usr/bin/hugo /usr/local/bin/hugo
COPY --from=hugo /lib/ld-musl-*.so.1 /lib/
COPY --from=hugo /usr/lib/libgcc_s.so.1 /usr/lib/
COPY --from=hugo /usr/lib/libstdc++.so.6* /usr/lib/
COPY --from=ryder /ryder /opt/sad/ryder
RUN mkdir /data && chown -R node:node /app /data
USER node
EXPOSE 4400
CMD ["node", "dist/index.js"]
