# Generate these once; never commit their real values.
SAD_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_BASE64
SAD_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
SAD_WORKER_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

SAD_PUBLIC_URL=http://localhost:4400
SAD_PORT=4400
SAD_DATA_DIR=/data
SAD_TRUST_PROXY=false
SAD_PRIVATE_TARGET_ALLOWLIST=
SAD_WORKER_CONCURRENCY=1
SAD_LOG_LEVEL=info

