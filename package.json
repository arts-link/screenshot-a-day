{
  "name": "screenshot-a-day",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted visual history for websites",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.16.0 <12.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "build": "pnpm runtime:check && pnpm -r build",
    "check": "pnpm runtime:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm site:check && pnpm version:check",
    "dev": "pnpm runtime:check && pnpm --filter @sad/contracts build && pnpm --filter @sad/core build && pnpm --parallel --filter @sad/api --filter @sad/web --filter @sad/worker dev",
    "docs:check": "node scripts/check-docs.mjs",
    "site:check": "node scripts/check-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm runtime:check && node scripts/e2e-smoke.mjs",
    "release:evidence": "node scripts/collect-release-evidence.mjs",
    "release:restore-rehearsal": "node scripts/rehearse-restore.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @sad/contracts build && pnpm --filter @sad/core build && pnpm -r typecheck",
    "version:check": "node scripts/check-version.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
